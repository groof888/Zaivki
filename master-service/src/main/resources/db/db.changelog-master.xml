<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260403-1" author="groof888">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="external_id" type="BIGINT">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="20260403-2" author="groof888">
        <createTable tableName="masters">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="specialization" type="VARCHAR(255)"/>
            <column name="experience_years" type="INT"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="user_id" type="BIGINT">
                <constraints unique="true" nullable="false"
                             foreignKeyName="fk_master_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260407-3-final-v3" author="groof888">
        <createTable tableName="emergency_events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="worker_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="worker_last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="payout_amount" type="DECIMAL(19,2)" defaultValueNumeric="50000.00">
                <constraints nullable="false"/>
            </column>
            <column name="event_date" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="20260407-4-final-v3" author="groof888">
        <createTable tableName="master_tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_name" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="ticket_id" type="BIGINT"/>
            <column name="master_id" type="BIGINT">
                <constraints foreignKeyName="fk_task_master"
                             referencedTableName="masters"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>